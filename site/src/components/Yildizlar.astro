---
// Sabit tohumlu yıldız katmanı: her derlemede aynı dizilim (sayfa geçişlerinde zıplamaz).
const { adet = 90, tohum = 7 } = Astro.props as { adet?: number; tohum?: number };
let s = tohum;
const rastgele = () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646;
const yildizlar = Array.from({ length: adet }, () => ({
  x: (rastgele() * 100).toFixed(2),
  y: (rastgele() * 100).toFixed(2),
  b: [1, 1.5, 2, 2, 2.5, 3][Math.floor(rastgele() * 6)],
  o: (0.2 + rastgele() * 0.6).toFixed(2),
}));
---
<div class="yildizlar" aria-hidden="true">
  {yildizlar.map((y) => <i style={`left:${y.x}%;top:${y.y}%;width:${y.b}px;height:${y.b}px;opacity:${y.o}`}></i>)}
</div>
