---
// Bankadaki bir soruyu gösterir: soru görseli + şıklar. dogruGoster: doğru şıkkı yeşille işaretler.
import { soru, soruGorseli, gorselBicimi, HARFLER } from '../data/sorular';
interface Props { anahtar: string; dogruGoster?: boolean; kucuk?: boolean; duz?: boolean; }
const { anahtar, dogruGoster = false, kucuk = false, duz = false } = Astro.props;
const s = soru(anahtar);
const siklar = HARFLER.slice(0, s.sikSayisi);
const zorluk = ({ easy: 'Kolay', medium: 'Orta', hard: 'Zor' } as Record<string, string>)[s.zorluk] ?? s.zorluk;
---
<figure class:list={['soru-karti', gorselBicimi(anahtar), { kucuk }]}>
  <figcaption class="soru-ust">
    <span>{s.sinif}. sınıf · {zorluk}</span>
    <b>{s.soruMetni}</b>
  </figcaption>
  <img class="soru-gorsel" src={soruGorseli(anahtar, 'soru', duz)} alt={`Soru görseli: ${s.soruMetni}`} loading="lazy" />
  {s.hafiza && <p class="hafiza-not">Uygulamada bu görsel {s.hafiza} saniye gösterilir, sonra kapanır ve soru gelir. Evde görseli {s.hafiza} saniye gösterip kapatarak deneyin.</p>}
  <ol class="siklar" style={`--adet:${siklar.length}`}>
    {siklar.map((h) => (
      <li class:list={['sik', { dogru: dogruGoster && h === s.dogru }]}>
        <span class="harf">{h}</span>
        <img src={soruGorseli(anahtar, h.toLowerCase() as 'a', duz)} alt={`${h} şıkkı`} loading="lazy" />
      </li>
    ))}
  </ol>
</figure>
<style>
  .soru-karti { margin: 0; display: grid; gap: 14px; }
  .soru-ust { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 16px; }
  .soru-ust span { font-size: 0.8rem; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; color: var(--kagit-metin-2); }
  .soru-ust b { font-family: var(--font-baslik); font-size: 1.2rem; color: var(--kagit-metin); }
  .soru-gorsel { width: 100%; max-height: 340px; object-fit: contain; background: #fff; border: 1.5px solid var(--kagit-cizgi); border-radius: 16px; padding: 10px; }
  .siklar { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--adet), minmax(0, 1fr)); gap: 12px; }
  /* Şık görseli yerleşime katılmaz: Safari aspect-ratio kutusundaki yüzdeli yüksekliği çözmüyor, görsel alttan taşıp
     kutunun kenarını örtüyordu. Yükseklik genişlikten gelir (yüzdeli dolgu her tarayıcıda aynı): kare görsel alanı,
     üstünde harf şeridi (--ust), çevresinde --yan boşluk. */
  .sik { --ust: 22px; --yan: 8px; position: relative; border: 2px solid var(--kagit-cizgi); border-radius: 14px; background: #fff; }
  .sik::before { content: ''; display: block; padding-top: calc(100% + var(--ust) - var(--yan)); }
  .sik img { position: absolute; left: var(--yan); top: var(--ust); width: calc(100% - 2 * var(--yan)); height: calc(100% - var(--ust) - var(--yan)); object-fit: contain; }
  .harf { position: absolute; z-index: 1; left: 8px; top: 6px; font-family: var(--font-baslik); font-weight: 800; font-size: 1.05rem; color: var(--mor); }
  .sik.dogru { border-color: var(--yesil); box-shadow: 0 0 0 3px rgba(61, 220, 151, 0.35); background: #effcf6; }
  .sik.dogru .harf { color: #0e7a4b; }
  .sik.dogru::after { content: '✓'; position: absolute; right: 8px; top: 4px; font-weight: 900; color: #0e7a4b; }
  .kucuk .soru-gorsel { max-height: 240px; }
  /* Alt alta iki resim (fark bulma) gibi uzun görseller: yükseklik sınırı genişliği de kısıyor, daha yüksek izin ver. */
  .gorsel-dik .soru-gorsel { max-height: 640px; }
  .kucuk.gorsel-dik .soru-gorsel { max-height: 480px; }
  /* Telefonda 4 şık yan yana çok küçülüyor (siluet, simge): 2x2 ızgara. */
  @media (max-width: 520px) {
    .siklar[style*='--adet:4'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sik { --ust: 20px; --yan: 6px; }
  }
  .hafiza-not { margin: -4px 0 0; font-size: 0.9rem; font-weight: 800; color: #8a4b00; background: #fff5e6; border-radius: 10px; padding: 8px 12px; }
  .kucuk .soru-ust b { font-size: 1.05rem; }
</style>
