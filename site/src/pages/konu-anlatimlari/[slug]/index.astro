---
import Temel from '../../../layouts/Temel.astro';
import Blok from '../../../components/Blok.astro';
import Magazalar from '../../../components/Magazalar.astro';
import { KONULAR } from '../../../data/konular';
import { DIYAGRAM_SETLERI } from '../../../data/diyagramlar';
import type { Konu } from '../../../data/konu-tipleri';
import { SITE } from '../../../data/site';

export function getStaticPaths() {
  return KONULAR.map((konu) => ({ params: { slug: konu.slug }, props: { konu } }));
}

const { konu } = Astro.props as { konu: Konu };
const diyagramlar = DIYAGRAM_SETLERI[konu.slug] ?? {};
const tumBloklar = konu.bolumler.flatMap((b) => b.bloklar);
const ornekSayisi = tumBloklar.filter((b) => b.t === 'ornek').length;
const alistirmaSayisi = tumBloklar.reduce((n, b) => n + (b.t === 'alistirma' ? b.sorular.length : 0), 0);
const tarih = new Date(konu.guncelleme).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });

// Örnekler bütün bölümler boyunca sırayla numaralanır.
let ornekNo = 0;
const bolumler = konu.bolumler.map((b) => ({
  ...b,
  bloklar: b.bloklar.map((blok) => ({ blok, sira: blok.t === 'ornek' ? ++ornekNo : 0 })),
}));

const yapilandirilmis = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: `${konu.ad} Konu Anlatımı`,
  description: konu.ozet,
  inLanguage: 'tr',
  educationalLevel: konu.siniflar,
  learningResourceType: ['Konu anlatımı', 'Çözümlü örnek', 'Alıştırma'],
  isAccessibleForFree: true,
  dateModified: konu.guncelleme,
  url: `${SITE.adres}/konu-anlatimlari/${konu.slug}/`,
  publisher: { '@type': 'Organization', name: 'BilsemNova', url: SITE.adres },
};
---
<Temel
  baslik={`${konu.ad} Konu Anlatımı: Kurallar, Çözümlü Örnekler, PDF | BilsemNova`}
  aciklama={konu.ozet}
  gorsel={`/img/og/${konu.slug}.jpg`}
  tur="article"
  yapilandirilmis={yapilandirilmis}
>
  <section class="kap konu-bas">
    <nav class="kirinti" aria-label="Konum">
      <a href="/">Ana sayfa</a> <span aria-hidden="true">›</span>
      <a href="/konu-anlatimlari/">Konu Anlatımları</a> <span aria-hidden="true">›</span>
      <span>{konu.ad}</span>
    </nav>
    <span class="cip">{konu.alan} · {konu.siniflar}</span>
    <h1>{konu.ad} <span class="parlak">konu anlatımı</span></h1>
    <p class="giris">{konu.giris}</p>
    <div class="eylemler">
      <a class="dugme ana" href="slayt/">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="2.4" /><path d="M9 21h6M12 17v4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
        Slaytları aç
      </a>
      <a class="dugme ikincil" href={`/pdf/${konu.slug}-slaytlar.pdf`} download>
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5M5 20h14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        Slayt PDF
      </a>
      <a class="dugme ikincil" href={`/pdf/${konu.slug}-ders-notu.pdf`} download>
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5M5 20h14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        Ders notu PDF
      </a>
    </div>
    <ul class="meta">
      <li>{konu.okumaDakika} dk okuma</li>
      <li>{ornekSayisi} çözümlü örnek</li>
      <li>{alistirmaSayisi} alıştırma</li>
      <li>Güncelleme: <time datetime={konu.guncelleme}>{tarih}</time></li>
    </ul>
  </section>

  <div class="kap konu-govde">
    <nav class="icindekiler" aria-label="İçindekiler">
      <details open>
        <summary>İçindekiler</summary>
        <ol>
          {konu.bolumler.map((b) => <li><a href={`#${b.id}`}>{b.baslik}</a></li>)}
        </ol>
      </details>
    </nav>

    <article class="makale">
      {bolumler.map((b) => (
        <section class="kagit bolum-kart" id={b.id}>
          <h2>{b.baslik}</h2>
          {b.bloklar.map(({ blok, sira }) => <Blok blok={blok} diyagramlar={diyagramlar} sira={sira} />)}
        </section>
      ))}

      <section class="konu-cagri">
        <div>
          <span class="cip sari">BİLSEMNOVA</span>
          <h2>Uygulamada {konu.uygulamadakiSoru} {konu.ad.toLocaleLowerCase('tr')} sorusu var</h2>
          <p>1, 2 ve 3. sınıf için kolaydan zora sıralı sorular. Yanlış cevapta nedenini anlatır; veli karnesinde bu konudaki başarıyı görürsünüz.</p>
          <Magazalar kaynak={`konu_${konu.slug.replace(/-/g, '_')}`} />
        </div>
        <img src="/img/deha-thumbsup.webp" alt="" width="560" height="560" loading="lazy" />
      </section>
    </article>
  </div>
</Temel>

<style>
  .konu-bas { display: grid; gap: 18px; justify-items: start; padding-block: clamp(36px, 6vw, 70px) clamp(28px, 4vw, 44px); }
  .konu-bas h1 { max-width: 900px; }
  .giris { color: var(--metin-2); font-size: clamp(1.08rem, 1.5vw, 1.22rem); max-width: 820px; }
  .kirinti { font-size: 0.92rem; color: var(--metin-3); display: flex; flex-wrap: wrap; gap: 8px; }
  .kirinti a { color: var(--metin-2); }
  .eylemler { display: flex; flex-wrap: wrap; gap: 12px; }
  .meta { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; color: var(--metin-3); font-size: 0.95rem; }
  .meta li { display: inline-flex; align-items: center; gap: 8px; }
  .meta li + li::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--metin-3); margin-left: -12px; }

  .konu-govde { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 28px; align-items: start; }
  .icindekiler { position: sticky; top: 92px; }
  .icindekiler details { padding: 18px 20px; border-radius: var(--r); background: rgba(18, 15, 58, 0.85); border: 1px solid var(--cizgi); }
  .icindekiler summary { cursor: pointer; font-family: var(--font-baslik); font-weight: 800; font-size: 1.15rem; list-style: none; }
  .icindekiler summary::-webkit-details-marker { display: none; }
  .icindekiler ol { margin: 12px 0 0; padding-left: 1.2em; display: grid; gap: 8px; color: var(--metin-3); font-size: 0.95rem; }
  .icindekiler a { color: var(--metin-2); text-decoration: none; }
  .icindekiler a:hover { color: #fff; text-decoration: underline; }

  .makale { display: grid; gap: 26px; min-width: 0; }
  .bolum-kart { display: grid; gap: 22px; scroll-margin-top: 90px; }
  .bolum-kart > h2 { color: var(--kagit-metin); font-size: clamp(1.7rem, 3vw, 2.3rem); }

  .konu-cagri { display: grid; grid-template-columns: 1fr 200px; gap: 20px; align-items: center; padding: clamp(24px, 4vw, 44px); border-radius: var(--r-buyuk); background: linear-gradient(135deg, #2b2275, #1b1650); border: 1px solid var(--cizgi); }
  .konu-cagri > div { display: grid; gap: 16px; justify-items: start; }
  .konu-cagri h2 { font-size: clamp(1.5rem, 2.8vw, 2.1rem); }
  .konu-cagri p { color: var(--metin-2); }

  @media (max-width: 960px) {
    .konu-govde { grid-template-columns: 1fr; }
    .icindekiler { position: static; }
    .icindekiler details:not([open]) { padding-block: 14px; }
  }
  @media (max-width: 620px) {
    .konu-cagri { grid-template-columns: 1fr; }
    .konu-cagri img { width: 150px; justify-self: center; }
  }
</style>
